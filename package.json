{
  "name": "rimtrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Webapp-PoC: kontinuierliche Seiten- und Höhenschlagmessung beim Zentrieren eines MTB-Hinterrads",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "uplot": "^1.6.32"
  }
}
